{
  "format_version": "1.8.0",
  "animations": {
    "animation.blockai.falling_tree.fall": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [
            "math.min(query.life_time * query.life_time * 75, 90)",
            0,
            0
          ]
        },
        "leaves": {
          "position": [
            0,
            "math.max(query.property('blockai:height') - 2, 0) * 16",
            0
          ]
        }
      }
    }
  }
}
