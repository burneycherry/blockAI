            "Geometry.slim",
            "Geometry.macho"
          ]
        }
      },
      "geometry": "Array.geos[v.build]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.skins[v.char * 3 + (v.outfit < 3 ? v.outfit : 0)]"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "tool_axe": "v.outfit == 2 && !v.sleep"
        },
        {
          "tool_hoe": "v.outfit == 1 && !v.sleep"
        },
        {
          "brim": "v.outfit == 1"
        }
      ]
    },
    "controller.render.blockai_invisible": {
      "geometry": "Geometry.default",
      "materials": [
        {
